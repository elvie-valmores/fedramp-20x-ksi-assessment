{
  "id": "iam-apm-cfg-aws-password-policy",
  "indicator": "KSI-IAM-APM",
  "mechanism": "cloud_api_config_read",
  "evidence_type": "CFG",
  "description": "The account password policy holds what account.tf declares: 14 characters, all four character classes, 24 remembered, 90-day maximum age. It governs the fallback lane only -- root -- since there are no IAM users",
  "required_cadence": "3 days",
  "params": {
    "provider": "aws",
    "resource": "password_policy",
    "expected": {
      "MinimumPasswordLength": 14,
      "RequireSymbols": true,
      "RequireNumbers": true,
      "RequireUppercaseCharacters": true,
      "RequireLowercaseCharacters": true,
      "PasswordReusePrevention": 24,
      "MaxPasswordAge": 90,
      "AllowUsersToChangePassword": true
    }
  },
  "matrix_rows": [
    {
      "row": "KSI-IAM-APM.verify.4",
      "covers": "full"
    }
  ]
}
